# Copy this file to .env and adjust for your environment.
# Local dev (default if not set): http://localhost:8080
VITE_API_URL=http://localhost:8080

# Google OAuth Client ID (Web application type) from
# https://console.cloud.google.com/apis/credentials
# Must exactly match google.client-id in the backend's application.properties.
# Leave blank to disable the Google sign-in button (it'll show a "not configured" note instead).
VITE_GOOGLE_CLIENT_ID=
